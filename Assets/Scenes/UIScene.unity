  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Trong tr\xF2 ch\u01A1i n\xE0y, ng\u01B0\u1EDDi ch\u01A1i s\u1EBD kh\xE1m
    ph\xE1 b\u1EA3n \u0111\u1ED3, n\xE9 tr\xE1nh ch\u01B0\u1EDBng ng\u1EA1i v\u1EADt
    v\xE0 ti\xEAu di\u1EC7t qu\xE1i v\u1EADt \u0111\u1EC3 thu th\u1EADp Coin (t\u0103ng
    \u0111i\u1EC3m) c\xF9ng Ch\xECa kh\xF3a (v\u1EADt ph\u1EA9m b\u1EAFt bu\u1ED9c).
    Ch\xECa kh\xF3a c\xF3 th\u1EC3 t\xECm th\u1EA5y tr\xEAn map ho\u1EB7c r\u01A1i
    ra t\u1EEB qu\xE1i v\u1EADt, l\xE0 \u0111i\u1EC1u ki\u1EC7n c\u1EA7n thi\u1EBFt
    \u0111\u1EC3 m\u1EDF c\u1ED5ng v\xE0 ti\u1EBFn sang m\xE0n ch\u01A1i ti\u1EBFp
    theo.\n\u0110i\u1EC1u ki\u1EC7n ho\xE0n th\xE0nh m\xE0n ch\u01A1i:\n- T\xECm
    \u0111\u01B0\u1EE3c ch\xECa kh\xF3a v\xE0 qua m\xE0n\n- Thu th\u1EADp \u0111\u1EE7
    6 coin\n- \u0110\xE1nh b\u1EA1i \xEDt nh\u1EA5t 2 qu\xE1i v\u1EADt\n"
